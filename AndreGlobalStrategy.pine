//@version=5
indicator("Andre Global Strategy - The Vault", "The Vault", overlay=true, max_boxes_count=500, max_labels_count=500)

utc_offset = input.int(3, "UTC Offset (Hours)", minval=-12, maxval=14, group="Sessions")
htf_res = input.timeframe("240", "HTF Timeframe", group="Structure")
rr_target = input.float(2.0, "Risk/Reward Multiplier", group="Risk Management")
adi_multiplier = input.float(1.0, "ADI Multiplier", group="Proprietary Core")

bull_c = input.color(color.new(#26a69a, 70), "Bullish", group="Visuals")
bear_c = input.color(color.new(#ef5350, 70), "Bearish", group="Visuals")
mtf_c = input.color(color.new(#ffeb3b, 50), "MTF Confluence", group="Visuals")
dash_c = input.color(color.new(#1e222d, 10), "Dashboard", group="Visuals")

type BoxZone
    box b
    float top
    float bottom
    bool is_bull
    int test_count
    label rr_lbl
    float partial_pct
    color base_color

var ob_bulls = array.new<BoxZone>(0)
var ob_bears = array.new<BoxZone>(0)

get_ts(hour_str) =>
    h = str.toint(str.substring(hour_str, 0, 2))
    m = str.toint(str.substring(hour_str, 2, 4))
    adj_h = (h + utc_offset) % 24
    adj_h := adj_h < 0 ? adj_h + 24 : adj_h
    str.format("{0,number,00}{1,number,00}", adj_h, m)

s_asia = time(timeframe.period, get_ts("2000") + "-" + get_ts("0000") + ":23456")
s_frankfurt = time(timeframe.period, get_ts("0700") + "-" + get_ts("0800") + ":23456")
s_london = time(timeframe.period, get_ts("0800") + "-" + get_ts("1200") + ":23456")
s_ny = time(timeframe.period, get_ts("1300") + "-" + get_ts("1700") + ":23456")

[htf_h, htf_l] = request.security(syminfo.tickerid, htf_res, [ta.pivothigh(5, 5), ta.pivotlow(5, 5)], lookahead=barmerge.lookahead_on)
var float last_htf_ph = na
var float last_htf_pl = na
if not na(htf_h)
    last_htf_ph := htf_h
if not na(htf_l)
    last_htf_pl := htf_l

atr_val = ta.atr(14)
price_disp = atr_val != 0 ? math.abs(close - open) / atr_val : 0
vol_dev = ta.stdev(volume, 50)
vol_int = vol_dev != 0 ? volume / vol_dev : 0
andre_index = ta.wma(price_disp * vol_int, 3)
adi_threshold = ta.percentile_linear(andre_index, 100, 75) * adi_multiplier
is_institutional_move = andre_index > adi_threshold

ph = ta.pivothigh(high, 5, 5)
pl = ta.pivotlow(low, 5, 5)
var float lastPH = na
var float lastPL = na
var float prevPH = na
var float prevPL = na

if not na(ph) 
    prevPH := lastPH
    lastPH := ph
if not na(pl) 
    prevPL := lastPL
    lastPL := pl

vol_avg20 = ta.sma(volume, 20)
is_vol_spike = volume > vol_avg20 * 1.5
sweep_u = high > lastPH and close <= lastPH and is_vol_spike
sweep_d = low < lastPL and close >= lastPL and is_vol_spike

var int market_trend = 0
if ta.crossover(close, lastPH)
    market_trend := 1
else if ta.crossunder(close, lastPL)
    market_trend := -1

choch_u = market_trend == -1 and ta.crossover(close, lastPH)
choch_d = market_trend == 1 and ta.crossunder(close, lastPL)
msb_u = market_trend == 1 and ta.crossover(close, lastPH)
msb_d = market_trend == -1 and ta.crossunder(close, lastPL)

equilibrium = (nz(lastPH) + nz(lastPL)) / 2
is_discount = close < equilibrium
is_premium = close > equilibrium

if (msb_u or choch_u) and is_institutional_move and is_discount
    int best_idx = -1
    float max_v = 0
    for i = 1 to 20
        if close[i] < open[i] and volume[i] > max_v
            max_v := volume[i]
            best_idx := i
    if best_idx != -1
        float entry = high[best_idx]
        float sl = low[best_idx]
        float tp = entry + ((entry - sl) * rr_target)
        bool is_mtf = not na(last_htf_pl) and last_htf_pl <= high[best_idx] and last_htf_pl >= low[best_idx]
        color final_c = is_mtf ? mtf_c : bull_c
        box b = box.new(bar_index[best_idx], entry, bar_index, sl, bgcolor=final_c, border_color=na, extend=extend.right)
        label lbl = label.new(bar_index, sl, "TP: " + str.tostring(tp, format.mintick), style=label.style_label_up, size=size.tiny, textcolor=color.white)
        array.unshift(ob_bulls, BoxZone.new(b, entry, sl, true, 0, lbl, 0.0, final_c))

if (msb_d or choch_d) and is_institutional_move and is_premium
    int best_idx = -1
    float max_v = 0
    for i = 1 to 20
        if close[i] > open[i] and volume[i] > max_v
            max_v := volume[i]
            best_idx := i
    if best_idx != -1
        float entry = low[best_idx]
        float sl = high[best_idx]
        float tp = entry - ((sl - entry) * rr_target)
        bool is_mtf = not na(last_htf_ph) and last_htf_ph >= low[best_idx] and last_htf_ph <= high[best_idx]
        color final_c = is_mtf ? mtf_c : bear_c
        box b = box.new(bar_index[best_idx], sl, bar_index, entry, bgcolor=final_c, border_color=na, extend=extend.right)
        label lbl = label.new(bar_index, sl, "TP: " + str.tostring(tp, format.mintick), style=label.style_label_down, size=size.tiny, textcolor=color.white)
        array.unshift(ob_bears, BoxZone.new(b, sl, entry, false, 0, lbl, 0.0, final_c))

process_zones(array<BoxZone> arr) =>
    if array.size(arr) > 0
        for i = array.size(arr) - 1 to 0
            z = array.get(arr, i)
            ob_range = math.abs(z.top - z.bottom)
            current_pct = z.is_bull ? (math.max(0, z.top - low) / ob_range * 100) : (math.max(0, high - z.bottom) / ob_range * 100)
            z.partial_pct := math.max(z.partial_pct, nz(current_pct))
            int trans = z.test_count == 0 ? 70 : z.test_count == 1 ? 80 : 90
            if z.partial_pct > 50
                box.set_bgcolor(z.b, color.new(color.gray, 85))
            else
                box.set_bgcolor(z.b, color.new(z.base_color, trans))
            bool mitigated = z.is_bull ? close < z.bottom : close > z.top
            if mitigated
                box.set_extend(z.b, extend.none)
                box.set_right(z.b, bar_index)
                if not na(z.rr_lbl)
                    label.delete(z.rr_lbl)
                array.remove(arr, i)
            else if (z.is_bull ? low < z.top and low[1] >= z.top : high > z.bottom and high[1] <= z.bottom)
                z.test_count += 1

process_zones(ob_bulls)
process_zones(ob_bears)

bgcolor(not na(s_asia) ? color.new(color.purple, 98) : na)
bgcolor(not na(s_frankfurt) ? color.new(color.orange, 98) : na)
bgcolor(not na(s_london) ? color.new(color.blue, 98) : na)
bgcolor(not na(s_ny) ? color.new(color.green, 98) : na)

plotshape(choch_u, "CH", shape.circle, location.belowbar, color.lime, size=size.tiny)
plotshape(choch_d, "CH", shape.circle, location.abovebar, color.maroon, size=size.tiny)
plotshape(sweep_u or sweep_d, "SW", shape.diamond, location.top, color.yellow, size=size.small)

var table d = table.new(position.top_right, 2, 5, border_width=1, border_color=color.gray)
if barstate.islast
    table.cell(d, 0, 0, "Trend State", bgcolor=dash_c, text_color=color.white)
    table.cell(d, 1, 0, market_trend == 1 ? "BULLISH" : market_trend == -1 ? "BEARISH" : "FLAT", bgcolor=dash_c, text_color=market_trend == 1 ? color.green : color.red)
    table.cell(d, 0, 1, "ADI Power", bgcolor=dash_c, text_color=color.white)
    table.cell(d, 1, 1, str.tostring(andre_index, "#.##"), bgcolor=dash_c, text_color=is_institutional_move ? color.aqua : color.white)
    table.cell(d, 0, 2, "Active Session", bgcolor=dash_c, text_color=color.white)
    table.cell(d, 1, 2, not na(s_ny) ? "NY" : not na(s_london) ? "LDN" : not na(s_frankfurt) ? "FRA" : not na(s_asia) ? "ASIA" : "WAIT", bgcolor=dash_c, text_color=color.yellow)
    table.cell(d, 0, 3, "Signature", bgcolor=dash_c, text_color=color.gray)
    table.cell(d, 1, 3, "developer for andre", bgcolor=dash_c, text_color=color.white)

if barstate.islast
    label.new(bar_index, close, "developer for andre", style=label.style_none, textcolor=color.new(color.gray, 70), text_size=size.tiny)